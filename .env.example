# Copy this file to `.env` and fill in the variables below.
# DO NOT commit `.env` — it is git-ignored.

# === Zotero plugin development paths ===

# The path of the Zotero binary file.
# Path delimiter must be escaped as `\\` on win32.
# MacOS example: /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = C:\\Program Files\\Zotero\\zotero.exe

# The path of the Zotero profile used for development.
# Create a dedicated dev profile via `zotero.exe -p` to avoid touching your main library.
# @see https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = C:\\path\\to\\your\\dev\\profile

# Optional: the data directory for the dev profile (leave empty to use Zotero default).
# @see https://www.zotero.org/support/zotero_data
ZOTERO_PLUGIN_DATA_DIR =

# Optional: custom command to kill running Zotero processes during dev reload.
# ZOTERO_PLUGIN_KILL_COMMAND =

# Optional: GitHub token for `npm run release` — only needed if releasing from local machine.
# GITHUB_TOKEN =


# === Citation Radar API keys (for development only) ===
# In production, end users will enter these via the plugin's preference panel.
# These dev-time values are read by the plugin only when running in development mode.

# OpenAlex API key — get from https://openalex.org/settings/api (free, instant)
OPENALEX_API_KEY =

# Semantic Scholar API key — request from https://www.semanticscholar.org/product/api
# Optional: without it, the plugin falls back to the unauthenticated public pool (slower).
SEMANTIC_SCHOLAR_API_KEY =

# DeepSeek API key for development LLM testing — https://platform.deepseek.com
# In production, users will plug in their own provider (DeepSeek/OpenAI/Anthropic/Gemini).
DEEPSEEK_API_KEY =
